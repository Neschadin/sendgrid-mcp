{
  "name": "sendgrid-mcp",
  "version": "2.0.0",
  "description": "SendGrid MCP Server — templates, preflight send, diagnostics, account & console settings",
  "type": "module",
  "license": "MIT",
  "author": "Neschadin",
  "repository": {
    "type": "git",
    "url": "https://github.com/Neschadin/sendgrid-mcp.git"
  },
  "homepage": "https://github.com/Neschadin/sendgrid-mcp#readme",
  "bugs": {
    "url": "https://github.com/Neschadin/sendgrid-mcp/issues"
  },
  "keywords": [
    "mcp",
    "sendgrid",
    "twilio",
    "email",
    "transactional-email",
    "model-context-protocol"
  ],
  "bin": {
    "sendgrid-mcp": "bin/sendgrid"
  },
  "files": [
    "bin/sendgrid",
    "MCP_TOOLS.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "dev": "bun --env-file=.env --watch src/index.ts",
    "start": "bun --env-file=.env src/index.ts",
    "build": "bun build --compile src/index.ts --outfile bin/sendgrid",
    "build:release": "bash scripts/build-release.sh",
    "inspect": "bun --env-file=.env x @modelcontextprotocol/inspector bun --env-file=.env src/index.ts",
    "typecheck": "bun build src/index.ts --outdir .tmp-typecheck --target bun",
    "lint": "oxlint",
    "smoke": "bun run scripts/smoke-register-tools.ts",
    "test": "bun test tests"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "oxlint": "1.87.0",
    "typescript": "7.0.2"
  }
}
