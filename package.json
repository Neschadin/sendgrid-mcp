{
  "name": "@neschadin/sendgrid-mcp",
  "version": "3.0.0",
  "mcpName": "io.github.Neschadin/sendgrid-mcp",
  "description": "MCP server for Twilio SendGrid transactional email: preflight send, templates, delivery diagnostics, and console settings",
  "type": "module",
  "module": "src/index.ts",
  "license": "MIT",
  "author": "Neschadin",
  "repository": {
    "type": "git",
    "url": "https://github.com/Neschadin/sendgrid-mcp.git"
  },
  "homepage": "https://github.com/Neschadin/sendgrid-mcp#readme",
  "bugs": {
    "url": "https://github.com/Neschadin/sendgrid-mcp/issues"
  },
  "keywords": [
    "mcp",
    "sendgrid",
    "twilio",
    "email",
    "transactional-email",
    "model-context-protocol"
  ],
  "bin": {
    "sendgrid-mcp": "bin/sendgrid-mcp"
  },
  "files": [
    "bin",
    "src",
    "!**/*.test.ts",
    "MCP_TOOLS.md",
    "LICENSE",
    "README.md",
    "mcp.json.example"
  ],
  "engines": {
    "bun": ">=1.4.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "bun --env-file=.env --watch src/index.ts",
    "start": "bun --env-file=.env run bin/sendgrid-mcp",
    "build": "bun build --compile src/index.ts --outfile bin/sendgrid",
    "inspect": "bun --env-file=.env x @modelcontextprotocol/inspector bun --env-file=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "smoke": "bun run scripts/smoke-register-tools.ts",
    "test": "bun test tests",
    "prepack": "bun test && bun run typecheck"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "oxlint": "1.87.0",
    "typescript": "7.0.2"
  }
}
